# Rules cj-run never gets, even when an allow rule matches. Deny wins over allow.
Bash(gh pr merge*)
Bash(git push --force*)
Bash(git push -f*)
Bash(git push --delete*)
Bash(git push * --force*)
Bash(git push * -f*)
Bash(git push * --delete*)
Bash(gh api -X DELETE*)
Bash(gh api --method DELETE*)
Bash(gh api * -X DELETE*)
Bash(gh api * --method DELETE*)
Bash(gh issue delete*)
Bash(gh repo delete*)
# merging or deleting by other routes
Bash(gh api *merge*)
Bash(gh api *mergePullRequest*)
Bash(gh api -XDELETE*)
Bash(gh api * -XDELETE*)
Bash(gh api --method=DELETE*)
Bash(gh api * --method=DELETE*)
Bash(git push * :*)
Bash(git push * +*)
Bash(git push --mirror*)
Bash(git push * --mirror*)
Bash(git branch -D*)
Bash(git push *-*f*)
Bash(git branch *-d*)
Bash(git branch *--delete*)
Bash(gh repo archive*)
Bash(gh repo rename*)
